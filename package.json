{
  "name": "borkin-turnos",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "preview:frontend": "npm run preview --workspace frontend",
    "dev:all": "node scripts/local-postgres.mjs ensure && npm run dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:operations && npm run test --workspace backend && npm run test --workspace frontend",
    "test:operations": "node --test --test-isolation=none scripts/database/backup-utils.test.mjs",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:deploy": "npm run db:deploy --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:seed:demo": "npm run db:seed:demo --workspace backend",
    "docker:config": "docker compose --env-file .env.production config",
    "docker:migrate": "docker compose --env-file .env.production --profile operations run --rm migrate",
    "docker:seed": "docker compose --env-file .env.production --profile operations run --rm seed",
    "backup": "node scripts/database/backup.mjs",
    "restore": "node scripts/database/restore.mjs",
    "backup:docker": "node scripts/database/backup.mjs --docker --env-file .env.production",
    "restore:docker": "node scripts/database/restore.mjs --docker --env-file .env.production",
    "verify:dataset": "node scripts/database/verify-dataset.mjs",
    "verify:seed-idempotence": "node scripts/database/verify-seed-idempotence.mjs",
    "smoke:production": "node scripts/production/smoke.mjs",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "typescript": "6.0.3"
  }
}
