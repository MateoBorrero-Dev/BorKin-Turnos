# Copiar como .env.production fuera del control de versiones.
# No usar literalmente los valores CHANGE_ME.
PUBLIC_PORT=8080
PUBLIC_BIND_IP=127.0.0.1
PUBLIC_ORIGIN=https://turnos.example.com
# Cliente -> proxy TLS externo -> Nginx BorKin -> Express: dos saltos confiables.
TRUST_PROXY_HOPS=2

POSTGRES_DB=borkin
POSTGRES_USER=borkin
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
# La contraseña debe estar codificada para URL si contiene caracteres reservados.
DATABASE_URL=postgresql://borkin:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/borkin?schema=public

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=true
LOG_LEVEL=info
MAX_UPLOAD_BYTES=2000000

BUSINESS_NAME=BorKin Turnos
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_UNIQUE_ADMIN_PASSWORD_12_CHARS_MINIMUM

# Destino local del host para los paquetes creados por backup:docker.
BACKUP_DIR=./backups
